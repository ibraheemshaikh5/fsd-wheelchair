# Chair link settings. Copy the lines you need into service/.env (gitignored) or
# export them in the shell that runs the service. Never commit a real token.
#
# Make a token with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The same token goes on the board (its own gitignored config file).
# The service refuses to start while this is still the placeholder below.
DRIVE_CHAIR_TOKEN=CHANGE-ME-to-a-long-random-token

# The model's token for POST /api/chair/drive; must differ from the one above.
# Export the same value in the shell that runs the model viewer. Unset = no model driving.
# DRIVE_CHAIR_DRIVER_TOKEN=CHANGE-ME-to-another-long-random-token

# Optional; these are the defaults.
# DRIVE_CHAIR_MAX_DRIVE_HOLD_MS=600
# DRIVE_CHAIR_RATE_HZ=20
# DRIVE_CHAIR_TTL_MS=200
# DRIVE_CHAIR_MAX_TEST_SPEED_MPS=0.5
# DRIVE_CHAIR_MAX_TEST_TURN_RADPS=0.5
# DRIVE_CHAIR_MAX_TEST_DURATION_MS=3000
# DRIVE_CHAIR_STATUS_STALE_MS=500
# DRIVE_CHAIR_IDLE_TIMEOUT_MS=2000
# DRIVE_CHAIR_MAX_COMMAND_LAG_MS=500
